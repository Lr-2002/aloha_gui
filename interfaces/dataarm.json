{
  "auto_start_stack": false,
  "require_sudo_password": false,
  "stack_enabled": false,
  "collector_backend": "dataarm",
  "dataarm_run_module": "control.run_robot",
  "dataarm_python_bin": "python3",
  "dataarm_workdir": "/home/lr-2002/project/DataArm/dataarm",
  "dataarm_config_path": "control/config_examples/system_dual_arm.yaml",
  "dataarm_api_mode": "dual",
  "dataarm_arms": "left_arm,right_arm",
  "dataarm_mode": "teach",
  "dataarm_headless": true,
  "dataarm_record": true,
  "dataarm_duration": 0,
  "dataarm_mid_fix_template": "{user_id}/{task_id}",
  "dataarm_locked_joints": "",
  "dataarm_auto_stop_on_fault": true,
  "dataarm_auto_stop_blink_red_seconds": 5.0,
  "dataarm_auto_stop_blink_period_seconds": 0.5,
  "dataarm_auto_stop_trigger_patterns": [
    "Deploy fail-fast triggered:",
    "WORK mode requirement failed:",
    "Robot initialization failed",
    "Failed to send command: \\(5, 'Input/output error'\\)"
  ],
  "dataarm_extra_args": [
    "--no-arm-telemetry"
  ],
  "dataarm_env": {}
}
