{
  "data_root": "~/data",
  "python_bin": "python3",
  "collect_script": "",
  "collect_workdir": "",
  "collect_max_timesteps": -1,
  "collect_extra_args": [],
  "collect_shell_template": "source ~/miniconda3/etc/profile.d/conda.sh && conda activate aloha && source /opt/ros/noetic/setup.bash && source ~/cobot_magic/Piper_ros_private-ros-noetic/devel/setup.bash && python ~/cobot_magic/collect_data/collect_data.py --dataset_dir {dataset_dir} --task_name {task_name} --episode_idx {episode_idx} --max_timesteps {max_timesteps}",
  "replay_shell_template": "",
  "tasks_csv_autoload": true,
  "tasks_csv_path": "EXAMPLE.CSV",
  "tasks_csv_mode": "replace",
  "users_csv_autoload": true,
  "users_csv_path": "USERS_EXAMPLE.CSV",
  "users_csv_mode": "replace",
  "interfaces_csv_autoload": true,
  "interfaces_csv_path": "INTERFACES_EXAMPLE.CSV",
  "interfaces_csv_mode": "replace",
  "auto_restore_session": true,
  "auto_start_stack": true,
  "require_sudo_password": true,
  "stack_workdir": "",
  "stack_clean_env": true,
  "stack_env_path": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
  "stack_shell_login": true,
  "stack_python_bin": "/home/agilex/miniconda3/envs/aloha/bin/python3",
  "stack_pythonpath": "",
  "stack_pythonpath_auto": true,
  "stack_pythonpath_auto_paths": [
    "~/cobot_magic/Piper_ros_private-ros-noetic/src",
    "~/cobot_magic/Piper_ros_private-ros-noetic/devel/lib/python3/dist-packages"
  ],
  "roscore_cmd": "source /opt/ros/noetic/setup.bash && roscore",
  "arm_dep_check_cmd": "source /opt/ros/noetic/setup.bash && echo PYTHONPATH=$PYTHONPATH && which python3 && python3 -V && python3 -c \"import sys, importlib.util as u; print('sys.executable', sys.executable); print('sys.version', sys.version); print('sys.path', sys.path); spec=u.find_spec('piper_sdk'); print('piper_sdk_spec', spec); import yaml; print('yaml', yaml.__file__); sys.exit(0 if spec else 1)\"",
  "arm_dep_check_required": true,
  "arm_pre_cmd": "source /opt/ros/noetic/setup.bash && cd ~/cobot_magic/Piper_ros_private-ros-noetic && printf '%s\\n' \"$SUDO_PASSWORD\" | sudo -S bash can_config.sh",
  "arm_launch_cmd": "source /opt/ros/noetic/setup.bash && cd ~/cobot_magic/Piper_ros_private-ros-noetic && source devel/setup.bash && roslaunch piper start_ms_piper.launch mode:=0 auto_enable:=false",
  "camera_launch_cmd": "source /opt/ros/noetic/setup.bash && cd ~/cobot_magic/camera_ws && source devel/setup.bash && roslaunch astra_camera multi_camera.launch",
  "camera_pre_cmd": "source /opt/ros/noetic/setup.bash && rosnode kill /camera_f/camera /camera_l/camera /camera_r/camera",
  "camera_cleanup_nodes": ["/camera_f/camera", "/camera_l/camera", "/camera_r/camera"],
  "camera_cleanup_process_patterns": ["astra_camera", "ob_camera", "multi_camera"],
  "camera_cleanup_retries": 2,
  "camera_cleanup_delay": 1,
  "camera_cleanup_required": true,
  "camera_cleanup_use_sudo": true,
  "camera_cleanup_extra_cmd": "",
  "camera_cleanup_skip_if_topics_present": false,
  "camera_cleanup_skip_topics": [],
  "rosnode_list_cmd": "source /opt/ros/noetic/setup.bash && rosnode list",
  "topic_check_cmd": "source /opt/ros/noetic/setup.bash && rostopic list",
  "topic_check_on_start": false,
  "topic_echo_cmd": "source /opt/ros/noetic/setup.bash && timeout {timeout}s rostopic echo -n 1 {topic}",
  "topic_echo_timeout": 2,
  "require_topic_messages": true,
  "roscore_check_cmd": "source /opt/ros/noetic/setup.bash && rostopic list",
  "topic_info_cmd": "source /opt/ros/noetic/setup.bash && timeout {timeout}s rostopic info {topic}",
  "topic_info_timeout": 2,
  "rosnode_kill_cmd": "source /opt/ros/noetic/setup.bash && rosnode kill {nodes}",
  "required_topics": [
    "/master/joint_left",
    "/master/joint_right",
    "/puppet/joint_left",
    "/puppet/joint_right",
    "/puppet/end_pose_left",
    "/puppet/end_pose_right",
    "/puppet/end_pose_euler_left",
    "/puppet/end_pose_euler_right",
    "/puppet/arm_status_left",
    "/puppet/arm_status_right",
    "/camera_f/color/image_raw",
    "/camera_l/color/image_raw",
    "/camera_r/color/image_raw"
  ],
  "optional_topics": [
    "/camera_f/color/camera_info",
    "/camera_l/color/camera_info",
    "/camera_r/color/camera_info",
    "/camera_f/aligned_depth_to_color/image_raw",
    "/camera_l/aligned_depth_to_color/image_raw",
    "/camera_r/aligned_depth_to_color/image_raw",
    "/camera_f/aligned_depth_to_color/camera_info",
    "/camera_l/aligned_depth_to_color/camera_info",
    "/camera_r/aligned_depth_to_color/camera_info",
    "/odom",
    "/tracer_states",
    "/cmd_vel"
  ],
  "master_topics": ["/master/joint_left", "/master/joint_right"],
  "auto_restart_master": true,
  "master_restart_retries": 2,
  "master_restart_delay": 2,
  "topic_check_retries": 5,
  "topic_check_delay": 1,
  "stack_start_delay": 2,
  "tail_lines": 200,
  "collect_shell_login": true
}
